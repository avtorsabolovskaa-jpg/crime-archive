---
import { createClient } from '@supabase/supabase-js'
import MainLayout from '../../layouts/MainLayout.astro';

const supabaseUrl = 'https://gmqqsadxpnmtowdtbpza.supabase.co';
const supabaseKey = 'sb_publishable_3k_dWR7Ng7cgbvFpk6ucyg_VnGvrggv';
const supabase = createClient(supabaseUrl, supabaseKey);

const { data: crimes, error } = await supabase
  .from('crimes')
  .select('*')
  .order('date', { ascending: false });
---

<MainLayout>
  <section class="archive-list">
    <h1>Архив дел</h1>
    {crimes && crimes.length > 0 ? (
      <div class="cases-grid">
        {crimes.map((crime) => (
          <div class="case-card">
            <span class="case-number">Дело № {crime.case_number || crime.id}</span>
            <h2><a href={`/crimes/${crime.id}`}>{crime.name}</a></h2>
            <div class="case-meta">
              <span>{crime.date}</span>
              <span>{crime.category || 'Без категории'}</span>
              <span class={`status-badge ${crime.status === 'раскрыто' ? 'status-closed' : 'status-open'}`}>
                {crime.status || 'Неизвестно'}
              </span>
            </div>
            <p class="case-excerpt">{crime.description?.slice(0, 150) || 'Описание отсутствует.'}</p>
            <a href={`/crimes/${crime.id}`} class="btn-read">Читать дело →</a>
          </div>
        ))}
      </div>
    ) : (
      <p>Записей пока нет.</p>
    )}
  </section>
</MainLayout>

<style>
  .archive-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .archive-list h1 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2.5rem;
    color: var(--color-accent, #8b1a1a);
    text-align: center;
    margin-bottom: 2rem;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .case-card {
    background: var(--color-card-bg, #fffef9);
    border: 1px solid var(--color-border, #d3cec4);
    border-radius: 4px;
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .case-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  }
  .case-number {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent, #8b1a1a);
    font-weight: 700;
  }
  .case-card h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    margin: 0.5rem 0;
    font-size: 1.3rem;
  }
  .case-card h2 a {
    color: var(--color-heading, #1a1a1a);
    text-decoration: none;
  }
  .case-card h2 a:hover {
    color: var(--color-accent, #8b1a1a);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 1rem;
  }
  .status-badge {
    padding: 0.1rem 0.6rem;
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.8rem;
  }
  .status-closed {
    background: #d4edda;
    color: #155724;
  }
  .status-open {
    background: #f8d7da;
    color: #721c24;
  }
  .case-excerpt {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 1rem;
  }
  .btn-read {
    color: var(--color-accent, #8b1a1a);
    font-weight: 700;
    text-decoration: none;
  }
  .btn-read:hover {
    text-decoration: underline;
  }
</style>