---
// =============================================
// НАЧАЛО БЛОКА: Импорты и подключение к Supabase
// =============================================
import MainLayout from '../../layouts/MainLayout.astro';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = 'https://gmqqsadxpnmtowdtbpza.supabase.co';
const supabaseKey = 'sb_publishable_3k_dWR7Ng7cgbvFpk6ucyg_VnGvrggv';
const supabase = createClient(supabaseUrl, supabaseKey);
// =============================================
// КОНЕЦ БЛОКА: Импорты и подключение
// =============================================

// =============================================
// НАЧАЛО БЛОКА: Запросы данных
// =============================================
// Общее количество дел
const { count: totalCases } = await supabase
  .from('crimes')
  .select('*', { count: 'exact', head: true });

// Количество раскрытых дел
const { count: closedCases } = await supabase
  .from('crimes')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'раскрыто');

// Количество нераскрытых / в производстве
const { count: openCases } = await supabase
  .from('crimes')
  .select('*', { count: 'exact', head: true })
  .neq('status', 'раскрыто');

// Последние 6 дел (для сетки карточек)
const { data: latestCrimes } = await supabase
  .from('crimes')
  .select('id, name, date, category, status, case_number, description, photo_url')
  .order('date', { ascending: false })
  .limit(6);

// Статистика по категориям
const { data: allCategories } = await supabase
  .from('crimes')
  .select('category');

const categoryCounts = allCategories
  ? allCategories.reduce((acc, { category }) => {
      if (category) acc[category] = (acc[category] || 0) + 1;
      return acc;
    }, {})
  : {};

const topCategories = Object.entries(categoryCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3);
// =============================================
// КОНЕЦ БЛОКА: Запросы данных
// =============================================
---

<MainLayout>
  <!-- =========================================
       НАЧАЛО БЛОКА: Герой-секция (счётчики)
       ========================================= -->
  <section class="hero">
    <div class="hero-content">
      <h1>Архив преступлений</h1>
      <p class="subtitle">Цифровой архив документов и свидетельств</p>
      <div class="counters">
        <div class="counter-item">
          <span class="counter-number">{totalCases || 0}</span>
          <span class="counter-label">Всего дел</span>
        </div>
        <div class="counter-item">
          <span class="counter-number">{closedCases || 0}</span>
          <span class="counter-label">Раскрыто</span>
        </div>
        <div class="counter-item">
          <span class="counter-number">{openCases || 0}</span>
          <span class="counter-label">В производстве</span>
        </div>
      </div>
    </div>
  </section>
  <!-- =========================================
       КОНЕЦ БЛОКА: Герой-секция
       ========================================= -->

  <!-- =========================================
       НАЧАЛО БЛОКА: Цитата
       ========================================= -->
  <section class="quote-section">
    <blockquote>
      <p>«Если женщина образована, экономически независима и контролирует своё тело — она не нуждается в мужчине как в защитнике, кормильце и посреднике перед Богом/государством.»</p>
    </blockquote>
  </section>
  <!-- =========================================
       КОНЕЦ БЛОКА: Цитата
       ========================================= -->

  <!-- =========================================
       НАЧАЛО БЛОКА: Основные категории
       ========================================= -->
  {topCategories.length > 0 && (
    <section class="categories">
      <h2 class="section-title">Основные категории</h2>
      <div>
        {topCategories.map(([cat, count]) => (
          <span class="category-badge">{cat}: {count}</span>
        ))}
      </div>
    </section>
  )}
  <!-- =========================================
       КОНЕЦ БЛОКА: Основные категории
       ========================================= -->

  <!-- =========================================
       НАЧАЛО БЛОКА: Последние поступления (карточки)
       ========================================= -->
  <section class="latest">
    <h2>Последние поступления</h2>
    <div class="cases-grid">
      {latestCrimes?.map((crime) => (
        <article class="case-card">
          <div class="case-card-image">
            {crime.photo_url ? (
              <img src={crime.photo_url} alt={crime.name} class="case-img" />
            ) : (
              <div class="placeholder-image">
                <span>📁</span>
              </div>
            )}
          </div>
          <div class="case-card-content">
            <span class="case-number">Дело № {crime.case_number || crime.id}</span>
            <h3><a href={`/crimes/${crime.id}`}>{crime.name}</a></h3>
            <div class="case-meta">
              <span>{crime.date}</span>
              <span>{crime.category || 'Без категории'}</span>
              <span class={`status-badge ${crime.status === 'раскрыто' ? 'status-closed' : 'status-open'}`}>
                {crime.status || 'Неизвестно'}
              </span>
            </div>
            <p class="case-excerpt">{crime.description?.slice(0, 150) || 'Описание отсутствует...'}</p>
            <a href={`/crimes/${crime.id}`} class="btn-read">Читать дело →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="view-all">
      <a href="/crimes" class="btn-all">Перейти в архив →</a>
    </div>
  </section>
  <!-- =========================================
       КОНЕЦ БЛОКА: Последние поступления
       ========================================= -->
</MainLayout>

<style>
  /* =========================================
     НАЧАЛО БЛОКА: Стили герой-секции
     ========================================= */
  .hero {
    background: var(--color-heading);
    color: #fff;
    padding: 4rem 2rem;
    text-align: center;
    border-bottom: 4px solid var(--color-accent);
  }
  .hero h1 {
    color: #fff;
    font-size: 3rem;
    margin-bottom: 0.5rem;
    letter-spacing: 2px;
  }
  .hero .subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 2rem;
    font-style: italic;
  }
  .counters {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .counter-item {
    text-align: center;
  }
  .counter-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .counter-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.7;
  }
  /* =========================================
     КОНЕЦ БЛОКА: Стили герой-секции
     ========================================= */

  /* =========================================
     НАЧАЛО БЛОКА: Стили цитаты
     ========================================= */
  .quote-section {
    max-width: 800px;
    margin: 4rem auto;
    padding: 2rem 3rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-accent);
    border-radius: 4px;
    text-align: center;
  }
  .quote-section blockquote {
    margin: 0;
  }
  .quote-section blockquote p {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-heading);
    margin: 0;
  }
  /* Декоративные кавычки */
  .quote-section blockquote p::before {
    content: '“';
    font-size: 4rem;
    color: var(--color-accent);
    opacity: 0.3;
    display: block;
    line-height: 1;
    margin-bottom: -0.5rem;
  }
  .quote-section blockquote p::after {
    content: '”';
    font-size: 4rem;
    color: var(--color-accent);
    opacity: 0.3;
    display: block;
    text-align: right;
    line-height: 1;
    margin-top: -1rem;
  }
  /* =========================================
     КОНЕЦ БЛОКА: Стили цитаты
     ========================================= */

  /* =========================================
     НАЧАЛО БЛОКА: Стили категорий и общих элементов
     ========================================= */
  .section-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-accent);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    text-align: center;
  }
  .categories {
    max-width: 1200px;
    margin: 0 auto 2rem;
    padding: 0 1.5rem;
  }
  .category-badge {
    display: inline-block;
    background: #e8e4d9;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    margin: 0.3rem;
    font-size: 0.9rem;
  }
  /* =========================================
     КОНЕЦ БЛОКА: Стили категорий
     ========================================= */

  /* =========================================
     НАЧАЛО БЛОКА: Стили сетки карточек
     ========================================= */
  .latest {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .latest h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
    position: relative;
  }
  .latest h2::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: var(--color-accent);
    margin: 1rem auto 0;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }
  .case-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }
  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }
  .case-card-image {
    height: 200px;
    overflow: hidden;
  }
  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder-image {
    background: #e8e4d9;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #999;
  }
  .case-card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .case-number {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .case-card-content h3 {
    margin: 0 0 0.8rem 0;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .case-card-content h3 a {
    color: var(--color-heading);
    text-decoration: none;
  }
  .case-card-content h3 a:hover {
    color: var(--color-accent);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 1rem;
  }
  .status-badge {
    padding: 0.1rem 0.6rem;
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.8rem;
  }
  .status-closed {
    background: #d4edda;
    color: #155724;
  }
  .status-open {
    background: #f8d7da;
    color: #721c24;
  }
  .case-excerpt {
    font-size: 0.9rem;
    color: #555;
    flex: 1;
  }
  .btn-read {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-accent);
  }
  .view-all {
    text-align: center;
    margin-top: 3rem;
  }
  .btn-all {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.2s;
  }
  .btn-all:hover {
    background: #6b1010;
  }
  /* =========================================
     КОНЕЦ БЛОКА: Стили сетки карточек
     ========================================= */

  /* =========================================
     НАЧАЛО БЛОКА: Адаптивность
     ========================================= */
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }
    .counter-number {
      font-size: 2.5rem;
    }
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }
  /* =========================================
     КОНЕЦ БЛОКА: Адаптивность
     ========================================= */
</style>