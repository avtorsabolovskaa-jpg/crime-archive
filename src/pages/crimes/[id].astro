import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const supabase = createClient(
    'https://gmqqsadxpnmtowdtbpza.supabase.co',
    'sb_publishable_3k_dWR7Ng7cgbvFpk6ucyg_VnGvrggv'
  )
  const { data: crimes } = await supabase.from('crimes').select('id')
  if (!crimes) return []
  return crimes.map((crime) => ({ params: { id: crime.id.toString() } }))
}

